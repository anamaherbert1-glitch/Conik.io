NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Meta / WhatsApp Cloud API — server-side only, never NEXT_PUBLIC_
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=29101246172809357
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SERVER_SECRET=
# base64 for exactly 32 random bytes (AES-256-GCM)
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# GREEN-API — server-side only, never NEXT_PUBLIC_
# Non-Partner mode: the customer/admin creates the GREEN-API instance in the GREEN-API console,
# then enters idInstance + apiTokenInstance + apiUrl in CONIK. No Partner token is required.
GREEN_API_WEBHOOK_SECRET=

# Optional future Partner mode (do not set for normal Developer/Business mode)
GREEN_API_PARTNER_TOKEN=
GREEN_API_PARTNER_API_URL=https://api.green-api.com
